{
  "model_version": "partqc-mnv3-v1",
  "backbone": "mobilenetv3_large_100",
  "pretrained": true,
  "grade_head": "ce",
  "seed": 42,
  "batch_size": 32,
  "epochs_a": 8,
  "lr_a": 0.001,
  "epochs_b_max": 30,
  "lr_b": 0.0001,
  "unfreeze_last_blocks": 2,
  "patience": 5,
  "min_delta": 0.0001,
  "label_smoothing": 0.1,
  "lambda_grade": 1.0,
  "weight_decay": 0.0001,
  "num_workers": 2,
  "dataset_dir": "ml/data",
  "split_file": "ml/splits/split_v1.csv",
  "models_root": "ml/models",
  "reports_root": "ml/reports",
  "checkpoints_root": "ml/checkpoints",
  "smoke": false
}
