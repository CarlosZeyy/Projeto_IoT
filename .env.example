# Copie para .env e preencha. Nunca commite o .env (R-03).
# Cada componente lê só as variáveis do seu bloco.

# ---------- qc-edge (notebook / gateway de borda) ----------
# Rodar com: uv run --env-file .env --package qc-edge qc-edge (o qc-edge não lê o .env sozinho).
# Variável vazia = não definida (vale o padrão). Valor inválido → o qc-edge sai com código 2.
# IPv4 literal em que a borda escuta (0.0.0.0 = todas as interfaces; IPv6 e nomes são recusados)
EDGE_HOST=0.0.0.0
# Porta TCP (1 a 65535); libere-a no firewall (edge/README.md)
EDGE_PORT=8000
# Opcional (segredo). Recomendado: deixar vazio, para que um token aleatório novo seja gerado
# a cada inicialização (reiniciar invalida os QR antigos); se definido, no mínimo 32 caracteres
EDGE_SESSION_TOKEN=
# Identificador da borda: ^[a-z0-9-]{3,32}$
DEVICE_ID=edge-01
# Segredo (SPEC-009): chave do dispositivo, gerada por scripts/register_device.py (mostrada uma
# única vez). Vazio = nada é enviado à nuvem (as inspeções ficam pendentes no outbox).
DEVICE_API_KEY=
# URL base da qc-api, sem /api/v1 no fim. https:// obrigatório (http:// só em localhost ou
# 127.0.0.1); sem usuário/senha, query ou fragmento; outro valor → código 2. Vazio = nada é enviado.
# Com --stub-model, nada é enviado nem gravado no outbox, mesmo com a chave e a URL (R-06).
CLOUD_API_URL=https://<subdominio>
# Diretório do modelo (SPEC-008); o nome do diretório resolvido (o alvo, se for um link
# simbólico) é o model_version. Vazio = sem modelo (o modo inspeção responde 503). O valor não é
# aparado: só espaços conta como definido. Definido mas inválido (arquivo faltando, sha256
# divergente, só espaços) → código 2.
# Ex.: ml/models/partqc-mnv3-v1
MODEL_DIR=
# Fotos capturadas (nunca saem da LAN, R-02); criado com 0700 se não existir; no .gitignore
EDGE_DATA_DIR=edge/data
# Modo coleta (SPEC-010): fotos do dataset (raw/...) e manifest.csv. Padrão ml/data (no .gitignore).
# Criado pela borda na primeira coleta, com diretórios 0700 e arquivos 0600. Nunca sai da LAN
# (R-02) e nunca vai para o Git: se usar outro caminho, deixe-o fora do repositório.
DATASET_DIR=ml/data
# Outbox SQLite (SPEC-009): inspeções gravadas antes da resposta e enviadas depois. Vazio =
# EDGE_DATA_DIR/outbox.sqlite3. Com --stub-model, nada vai para o outbox nem para a nuvem: o
# arquivo não é aberto nem criado, e as inspeções do stub ficam só na memória (R-06).
OUTBOX_PATH=edge/data/outbox.sqlite3
# Opcionais: sobrescrevem o limiar do decision.json do modelo (número de 0 a 1; fora disso ou
# não numérico → código 2). Vazio = vale o decision.json. Origem exibida no console e no /api/status.
TYPE_THRESHOLD=
UNUSABLE_THRESHOLD=
GRADE_REVIEW_THRESHOLD=

# ---------- qc-api (nuvem) ----------
# Connection string do pooler do Supabase (somente no servidor da API).
# Também é a URL padrão de infra/migrate.py (SPEC-003); nunca aparece em log.
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres
# Chave de leitura do dashboard (mínimo de 32 caracteres; ex.: secrets.token_urlsafe(32))
READ_API_KEY=
# Tamanho máximo do corpo das requisições, em bytes (acima disso: 413). Padrão: 262144 (256 KB)
MAX_BODY_BYTES=262144
# Nível de log da API: DEBUG, INFO, WARNING ou ERROR (nunca registra chaves nem o corpo)
LOG_LEVEL=INFO

# ---------- infra/.env (VPS, infra/compose.yaml) ----------
# Na VPS, o compose lê três arquivos em infra/, todos fora do Git, com chmod 600 e criados com um
# editor (docs/deployment-plan.md §4):
#   infra/.env           este bloco (interpolação do compose);
#   infra/.env.api       as variáveis do bloco qc-api (DATABASE_URL do pooler em modo
#                        transaction, READ_API_KEY e, opcionais, MAX_BODY_BYTES e LOG_LEVEL);
#   infra/.env.dashboard READ_API_KEY (o mesmo valor) e, opcional, MODEL_METRICS_PATH.
# API_BASE_URL não vai em nenhum deles: o compose a define como https://${PUBLIC_HOST}.
# Valores com $ vão entre aspas simples (sem aspas, o compose interpola e trunca o valor).
# Nome do subdomínio pessoal, sem esquema nem barra. O valor real nunca entra no Git (R-13).
PUBLIC_HOST=<subdominio>
# Limites de recursos por serviço (padrões abaixo). Ajuste conforme o free -h e o nproc da VPS:
# a soma da memória abaixo da RAM disponível, cada cpus <= nproc, e a API nunca abaixo de 512m
# sem uma decisão registrada no docs/deployment-plan.md.
API_MEM_LIMIT=512m
API_CPUS=1.0
DASHBOARD_MEM_LIMIT=1g
DASHBOARD_CPUS=1.0
CADDY_MEM_LIMIT=256m
CADDY_CPUS=0.5
# Limite de processos e threads por contêiner (pids_limit, SPEC-032). Medido em 2026-10-24: no
# máximo 15 no dashboard com 5 sessões, 51 na API com 100 requisições simultâneas e 11 no Caddy.
# Se um contêiner parar ou falhar ao criar threads, suba o valor aqui e rode "up -d".
API_PIDS_LIMIT=256
DASHBOARD_PIDS_LIMIT=256
CADDY_PIDS_LIMIT=256

# ---------- qc-dashboard ----------
# Na VPS, READ_API_KEY e MODEL_METRICS_PATH vão no infra/.env.dashboard, e API_BASE_URL vem do
# infra/compose.yaml (bloco infra/.env acima).
# O dashboard lê primeiro o st.secrets e, se a chave não existir lá, a variável de ambiente.
# Localmente, API_BASE_URL e READ_API_KEY vão em .streamlit/secrets.toml, na raiz do
# repositório (no .gitignore); rode da raiz: uv run --package qc-dashboard streamlit run
# dashboard/app.py. Não use este .env único para o dashboard: ele carregaria também
# DATABASE_URL e DEVICE_API_KEY no processo dele (dashboard/README.md).
# URL base da qc-api, sem /api/v1 no fim; https:// (http:// só em localhost ou 127.0.0.1)
API_BASE_URL=http://localhost:8001
# READ_API_KEY: segredo, o mesmo valor do bloco da API (enviado no header X-API-Key)
# Opcional: metrics.json da página "Sobre o modelo"; caminho relativo à raiz do repositório
# (ou absoluto). Vazio = ml/models/partqc-mnv3-v1/metrics.json
MODEL_METRICS_PATH=

# ---------- scripts/simulate.py ----------
# Também usa CLOUD_API_URL (bloco da borda) como URL padrão da API (https://; http:// só localhost).
# Dispositivo do simulador (^[a-z0-9-]{3,32}$), registrado com scripts/register_device.py
SIM_DEVICE_ID=sim-01
# Segredo: chave do dispositivo do simulador, impressa uma única vez por register_device.py
SIM_DEVICE_API_KEY=

# ---------- scripts/smoke_test.py (SPEC-015) ----------
# URL pública do dashboard: https://<subdominio>/ (usa também CLOUD_API_URL, READ_API_KEY,
# SIM_DEVICE_ID e SIM_DEVICE_API_KEY)
DASHBOARD_URL=

# ---------- testes locais ----------
# Banco descartável, só local (Docker da SPEC-001); nunca aponte para produção
TEST_DATABASE_URL=postgresql://postgres@localhost:55432/partqc_test
# Usado só pelo teste manual/slow de latência da SPEC-008 (CA-16); vazio → teste pulado
QC_REAL_MODEL_DIR=

# ---------- Segredos fora do .env (GitHub Secrets) ----------
# KEEPALIVE_URL (GitHub Secret do workflow keepalive.yml): https://<subdominio>
