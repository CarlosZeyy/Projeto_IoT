# Copie para .env e preencha. Nunca commite o .env (R-03).
# Cada componente lê só as variáveis do seu bloco.

# ---------- qc-edge (notebook / gateway de borda) ----------
EDGE_HOST=0.0.0.0
EDGE_PORT=8000
# Opcional: se vazio, um token aleatório é gerado a cada inicialização e exibido no QR
EDGE_SESSION_TOKEN=
DEVICE_ID=edge-01
# Gerada por scripts/register_device.py (mostrada uma única vez)
DEVICE_API_KEY=
CLOUD_API_URL=https://<seu-servico>.onrender.com
# Vazio até existir o primeiro modelo (S3); ex.: ml/models/partqc-mnv3-v1
MODEL_DIR=
EDGE_DATA_DIR=edge/data
DATASET_DIR=ml/data
OUTBOX_PATH=edge/data/outbox.sqlite3
# Opcionais: sobrescrevem o decision.json do modelo
TYPE_THRESHOLD=
UNUSABLE_THRESHOLD=
GRADE_REVIEW_THRESHOLD=

# ---------- qc-api (nuvem) ----------
# Connection string do pooler do Supabase (somente no servidor da API)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres
READ_API_KEY=

# ---------- qc-dashboard (em produção: Streamlit Secrets) ----------
API_BASE_URL=http://localhost:8001
# READ_API_KEY (mesmo valor do bloco da API)

# ---------- scripts/simulate.py ----------
SIM_DEVICE_ID=sim-01
SIM_DEVICE_API_KEY=

# ---------- scripts/smoke_test.py (SPEC-015) ----------
# URL pública do dashboard no Streamlit Community Cloud (usa também CLOUD_API_URL e READ_API_KEY)
DASHBOARD_URL=

# ---------- testes locais ----------
# Banco descartável, só local (Docker da SPEC-001); nunca aponte para produção
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/partqc_test
# Usado só pelo teste manual/slow de latência da SPEC-008 (CA-16); vazio → teste pulado
QC_REAL_MODEL_DIR=

# ---------- Segredos fora do .env (GitHub Secrets / Streamlit Secrets) ----------
# KEEPALIVE_URL (GitHub Secret)
